<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  html, body { margin: 0; padding: 0; background: #edece8; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
</style>
</head>
<body>

<div style="width: 100%; background: #edece8; padding: 32px 16px; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;">
  <div style="width: 100%; max-width: 660px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e0da;">

    <!-- Header -->
    <div style="padding: 28px 34px 24px; border-bottom: 1px solid #e2e0da;">
      <div style="display: flex; align-items: center; gap: 9px; margin-bottom: 18px;">
        <div style="width: 9px; height: 9px; border-radius: 50%; background: #3f8a63;"></div>
        <div style="font-size: 12px; letter-spacing: 0.09em; text-transform: uppercase; color: #8a867c; font-weight: 600;">USE Agent &middot; Weekly Report</div>
      </div>
      <div style="font-size: 26px; line-height: 1.2; font-weight: 650; color: #1a1917; letter-spacing: -0.01em;">{{ headline }}</div>
      <div style="margin-top: 8px; font-size: 14px; color: #6f6b62;">{{ weekRange }} &nbsp;&middot;&nbsp; {{ inboxLine }}</div>
    </div>

    <!-- Headline stats -->
    <div style="display: flex; flex-wrap: wrap; border-bottom: 1px solid #e2e0da;">
      {% for s in stats %}
      <div style="flex: 1 1 25%; min-width: 130px; padding: 22px 24px; border-right: 1px solid #eeece7; border-bottom: 1px solid #eeece7;">
        <div style="font-size: 32px; font-weight: 650; color: #1a1917; letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">{{ s.value }}</div>
        <div style="margin-top: 4px; font-size: 12.5px; color: #6f6b62; line-height: 1.35;">{{ s.label }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Classification split -->
    <div style="padding: 26px 34px;">
      <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin-bottom: 16px;">What we handled</div>
      <div style="display: flex; width: 100%; height: 14px; border-radius: 3px; overflow: hidden; background: #f0eee9;">
        <div style="width: {{ cls.coldWidth }}; background: #b5794a;"></div>
        <div style="width: {{ cls.bulkWidth }}; background: #5f83a6;"></div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 26px; margin-top: 16px;">
        <div style="flex: 1 1 200px;">
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span style="width: 9px; height: 9px; border-radius: 2px; background: #b5794a; display: inline-block;"></span>
            <span style="font-size: 22px; font-weight: 650; color: #1a1917; font-variant-numeric: tabular-nums;">{{ cls.coldCount }}</span>
            <span style="font-size: 13px; color: #6f6b62;">Cold sales outreach</span>
          </div>
          <div style="margin-top: 5px; margin-left: 17px; font-size: 12.5px; color: #9b968c;">{{ cls.coldNote }}</div>
        </div>
        <div style="flex: 1 1 200px;">
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span style="width: 9px; height: 9px; border-radius: 2px; background: #5f83a6; display: inline-block;"></span>
            <span style="font-size: 22px; font-weight: 650; color: #1a1917; font-variant-numeric: tabular-nums;">{{ cls.bulkCount }}</span>
            <span style="font-size: 13px; color: #6f6b62;">Bulk marketing</span>
          </div>
          <div style="margin-top: 5px; margin-left: 17px; font-size: 12.5px; color: #9b968c;">{{ cls.bulkNote }}</div>
        </div>
      </div>
    </div>

    <!-- Activity by day -->
    <div style="padding: 4px 34px 26px;">
      <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin-bottom: 16px;">Activity by day</div>
      {% for d in days %}
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 9px;">
        <div style="width: 34px; font-size: 12.5px; color: #6f6b62; font-weight: 600;">{{ d.name }}</div>
        <div style="flex: 1; height: 22px; background: #f4f2ee; border-radius: 3px; overflow: hidden;">
          <div style="width: {{ d.width }}; height: 100%; background: #3f8a63; border-radius: 3px;"></div>
        </div>
        <div style="width: 30px; text-align: right; font-size: 13px; color: #1a1917; font-weight: 600; font-variant-numeric: tabular-nums;">{{ d.count }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Response breakdown -->
    <div style="padding: 4px 34px 26px; border-top: 1px solid #eeece7;">
      <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 16px;">How each was handled</div>
      {% for r in responses %}
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 11px;">
        <div style="width: 190px; font-size: 13px; color: #46433d;">{{ r.name }}</div>
        <div style="flex: 1; height: 8px; background: #f4f2ee; border-radius: 4px; overflow: hidden;">
          <div style="width: {{ r.width }}; height: 100%; background: #a7a29a; border-radius: 4px;"></div>
        </div>
        <div style="width: 28px; text-align: right; font-size: 13px; color: #1a1917; font-weight: 600; font-variant-numeric: tabular-nums;">{{ r.count }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Top offenders -->
    <div style="padding: 4px 34px 26px; border-top: 1px solid #eeece7;">
      <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 6px;">Top repeat offenders</div>
      <div style="font-size: 12.5px; color: #9b968c; margin-bottom: 14px;">Senders we acted on most this week.</div>
      <table style="width: 100%; border-collapse: collapse;">
        {% for o in offenders %}
        <tr style="border-bottom: 1px solid #f0eee9;">
          <td style="padding: 9px 8px 9px 0; vertical-align: middle;">
            <div style="font-size: 13.5px; color: #1a1917; font-weight: 550;">{{ o.name }}</div>
            <div style="font-size: 11.5px; color: #9b968c; font-family: 'SF Mono', Menlo, Consolas, monospace; margin-top: 2px;">{{ o.addr }}</div>
          </td>
          <td style="padding: 9px 8px; vertical-align: middle; white-space: nowrap;">
            <span style="font-size: 11px; color: {{ o.typeColor }}; background: {{ o.typeBg }}; padding: 3px 8px; border-radius: 3px; font-weight: 600;">{{ o.type }}</span>
          </td>
          <td style="padding: 9px 0 9px 8px; text-align: right; vertical-align: middle; font-size: 15px; font-weight: 650; color: #1a1917; font-variant-numeric: tabular-nums; white-space: nowrap;">{{ o.count }}&times;</td>
        </tr>
        {% endfor %}
      </table>
    </div>

    <!-- Top themes -->
    <div style="padding: 4px 34px 30px; border-top: 1px solid #eeece7;">
      <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 16px;">Top themes</div>
      {% for t in themes %}
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
        <div style="width: 210px; font-size: 13px; color: #46433d;">{{ t.name }}</div>
        <div style="flex: 1; height: 8px; background: #f4f2ee; border-radius: 4px; overflow: hidden;">
          <div style="width: {{ t.width }}; height: 100%; background: #c2a878; border-radius: 4px;"></div>
        </div>
        <div style="width: 28px; text-align: right; font-size: 13px; color: #1a1917; font-weight: 600; font-variant-numeric: tabular-nums;">{{ t.count }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Footer -->
    <div style="padding: 20px 34px; border-top: 1px solid #e2e0da; background: #faf9f7;">
      <div style="font-size: 12px; color: #9b968c; line-height: 1.5;">{{ footerLine }}</div>
      <div style="font-size: 12px; color: #b8b4aa; margin-top: 6px;">Generated {{ generatedAt }} &middot; All actions are logged and reversible from your account.</div>
      <a href="https://github.com/gmr/use-agent/" style="display: inline-flex; align-items: center; gap: 7px; margin-top: 14px; text-decoration: none; font-size: 12.5px; color: #6f6b62; font-weight: 550;">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="#6f6b62" aria-hidden="true"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span>github.com/gmr/use-agent</span>
      </a>
    </div>

  </div>
</div>
</body>
</html>
