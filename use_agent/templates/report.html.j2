<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  html, body { margin: 0; padding: 0; background: #edece8; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
</style>
</head>
<body style="margin: 0; padding: 0; background: #edece8;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #edece8;">
  <tr>
    <td align="center" style="padding: 32px 16px; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 660px; background: #ffffff; border: 1px solid #e2e0da;">

        <!-- Header -->
        <tr>
          <td style="padding: 28px 34px 24px; border-bottom: 1px solid #e2e0da;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 18px;">
              <tr>
                <td style="padding-right: 9px;"><div style="width: 9px; height: 9px; border-radius: 50%; background: #3f8a63; font-size: 0; line-height: 0;">&nbsp;</div></td>
                <td style="font-size: 12px; letter-spacing: 0.09em; text-transform: uppercase; color: #8a867c; font-weight: 600;">USE Agent &middot; Weekly Report</td>
              </tr>
            </table>
            <div style="font-size: 26px; line-height: 1.2; font-weight: 650; color: #1a1917; letter-spacing: -0.01em;">{{ headline }}</div>
            <div style="margin-top: 8px; font-size: 14px; color: #6f6b62;">{{ weekRange }} &nbsp;&middot;&nbsp; {{ inboxLine }}</div>
          </td>
        </tr>

        <!-- Headline stats -->
        <tr>
          <td style="border-bottom: 1px solid #e2e0da;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                {% for s in stats %}
                <td width="25%" style="padding: 22px 24px; border-right: 1px solid #eeece7; vertical-align: top;">
                  <div style="font-size: 32px; font-weight: 650; color: #1a1917; letter-spacing: -0.02em;">{{ s.value }}</div>
                  <div style="margin-top: 4px; font-size: 12.5px; color: #6f6b62; line-height: 1.35;">{{ s.label }}</div>
                </td>
                {% endfor %}
              </tr>
            </table>
          </td>
        </tr>

        <!-- Classification split -->
        <tr>
          <td style="padding: 26px 34px;">
            <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin-bottom: 16px;">What we handled</div>
            <div style="width: 100%; height: 14px; border-radius: 3px; background: #f0eee9; font-size: 0; line-height: 0;"><div style="display: inline-block; vertical-align: top; width: {{ cls.coldWidth }}; height: 14px; background: #b5794a;"></div><div style="display: inline-block; vertical-align: top; width: {{ cls.bulkWidth }}; height: 14px; background: #5f83a6;"></div></div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 16px;">
              <tr>
                <td width="50%" style="vertical-align: top; padding-right: 13px;">
                  <div>
                    <span style="width: 9px; height: 9px; border-radius: 2px; background: #b5794a; display: inline-block;"></span>&nbsp;
                    <span style="font-size: 22px; font-weight: 650; color: #1a1917;">{{ cls.coldCount }}</span>&nbsp;
                    <span style="font-size: 13px; color: #6f6b62;">Cold sales outreach</span>
                  </div>
                  <div style="margin-top: 5px; margin-left: 17px; font-size: 12.5px; color: #9b968c;">{{ cls.coldNote }}</div>
                </td>
                <td width="50%" style="vertical-align: top; padding-left: 13px;">
                  <div>
                    <span style="width: 9px; height: 9px; border-radius: 2px; background: #5f83a6; display: inline-block;"></span>&nbsp;
                    <span style="font-size: 22px; font-weight: 650; color: #1a1917;">{{ cls.bulkCount }}</span>&nbsp;
                    <span style="font-size: 13px; color: #6f6b62;">Bulk marketing</span>
                  </div>
                  <div style="margin-top: 5px; margin-left: 17px; font-size: 12.5px; color: #9b968c;">{{ cls.bulkNote }}</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Activity by day -->
        <tr>
          <td style="padding: 4px 34px 26px;">
            <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin-bottom: 16px;">Activity by day</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              {% for d in days %}
              <tr>
                <td width="34" style="font-size: 12.5px; color: #6f6b62; font-weight: 600; padding: 0 12px 9px 0;">{{ d.name }}</td>
                <td style="padding: 0 0 9px;">
                  <div style="width: 100%; height: 22px; background: #f4f2ee; border-radius: 3px; font-size: 0; line-height: 0;"><div style="width: {{ d.width }}; height: 22px; background: #3f8a63; border-radius: 3px;"></div></div>
                </td>
                <td width="30" align="right" style="font-size: 13px; color: #1a1917; font-weight: 600; padding: 0 0 9px 12px;">{{ d.count }}</td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        <!-- Response breakdown -->
        <tr>
          <td style="padding: 4px 34px 26px; border-top: 1px solid #eeece7;">
            <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 16px;">How each was handled</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              {% for r in responses %}
              <tr>
                <td width="190" style="font-size: 13px; color: #46433d; padding: 0 12px 11px 0;">{{ r.name }}</td>
                <td style="padding: 0 0 11px; vertical-align: middle;">
                  <div style="width: 100%; height: 8px; background: #f4f2ee; border-radius: 4px; font-size: 0; line-height: 0;"><div style="width: {{ r.width }}; height: 8px; background: #a7a29a; border-radius: 4px;"></div></div>
                </td>
                <td width="28" align="right" style="font-size: 13px; color: #1a1917; font-weight: 600; padding: 0 0 11px 12px;">{{ r.count }}</td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        <!-- Top offenders -->
        <tr>
          <td style="padding: 4px 34px 26px; border-top: 1px solid #eeece7;">
            <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 6px;">Top repeat offenders</div>
            <div style="font-size: 12.5px; color: #9b968c; margin-bottom: 14px;">Senders we acted on most this week.</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
              {% for o in offenders %}
              <tr style="border-bottom: 1px solid #f0eee9;">
                <td style="padding: 9px 8px 9px 0; vertical-align: middle;">
                  <div style="font-size: 13.5px; color: #1a1917; font-weight: 600;">{{ o.name }}</div>
                  <div style="font-size: 11.5px; color: #9b968c; font-family: 'SF Mono', Menlo, Consolas, monospace; margin-top: 2px;">{{ o.addr }}</div>
                </td>
                <td style="padding: 9px 8px; vertical-align: middle; white-space: nowrap;">
                  <span style="font-size: 11px; color: {{ o.typeColor }}; background: {{ o.typeBg }}; padding: 3px 8px; border-radius: 3px; font-weight: 600;">{{ o.type }}</span>
                </td>
                <td style="padding: 9px 0 9px 8px; text-align: right; vertical-align: middle; font-size: 15px; font-weight: 650; color: #1a1917; white-space: nowrap;">{{ o.count }}&times;</td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        <!-- Top themes -->
        <tr>
          <td style="padding: 4px 34px 30px; border-top: 1px solid #eeece7;">
            <div style="font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: #8a867c; font-weight: 600; margin: 24px 0 16px;">Top themes</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              {% for t in themes %}
              <tr>
                <td width="210" style="font-size: 13px; color: #46433d; padding: 0 12px 10px 0;">{{ t.name }}</td>
                <td style="padding: 0 0 10px; vertical-align: middle;">
                  <div style="width: 100%; height: 8px; background: #f4f2ee; border-radius: 4px; font-size: 0; line-height: 0;"><div style="width: {{ t.width }}; height: 8px; background: #c2a878; border-radius: 4px;"></div></div>
                </td>
                <td width="28" align="right" style="font-size: 13px; color: #1a1917; font-weight: 600; padding: 0 0 10px 12px;">{{ t.count }}</td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding: 20px 34px; border-top: 1px solid #e2e0da; background: #faf9f7;">
            <div style="font-size: 12px; color: #9b968c; line-height: 1.5;">{{ footerLine }}</div>
            <div style="font-size: 12px; color: #b8b4aa; margin-top: 6px;">Generated {{ generatedAt }} &middot; All actions are logged and reversible from your account.</div>
            <div style="margin-top: 14px;">
              <a href="https://github.com/gmr/use-agent/" style="text-decoration: none; font-size: 12.5px; color: #6f6b62; font-weight: 600;">github.com/gmr/use-agent</a>
            </div>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
